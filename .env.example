# Copy to .env and adjust as needed.
# 由 apps/api 在启动时用 Node 原生 `process.loadEnvFile` 读取（见 apps/api/src/server.ts），
# Vite 也读它来定端口。已经存在的环境变量优先，所以 `PORT=4000 npm run dev:api` 能临时覆盖。

# Port the Node.js API listens on (apps/api).
# apps/api reads PORT; the Vite dev proxy reads API_PORT, falling back to PORT.
PORT=3000
# API_PORT=3000

# Port the Vite dev server listens on (apps/web)
WEB_PORT=5173

# ---------------------------------------------------------------------------
# 管理员登录（隐藏入口 /admin.html）
#
# 三项**缺任何一项**，/api/admin/* 就整体返回 503（fail-closed）——「忘了配」应该是
# 打不开门，而不是谁都能进。配好之后要重启后端（npm run dev:api）才生效。
# ---------------------------------------------------------------------------

# 管理员账号
ADMIN_USER=admin

# 管理员密码。**别用这里的占位值**，换成只有你知道的长口令。
ADMIN_PASSWORD=change-me

# 会话签名密钥（HMAC-SHA256 的密钥）。一串长随机即可；换掉它等于让所有已登录的会话立刻失效。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# 会话有效期（毫秒）。默认 8 小时。
# ADMIN_SESSION_TTL_MS=28800000

# HTTPS 部署时设成 1，给会话 cookie 加 `Secure`。
# ⚠️ 本地 http 调试**必须留空**：带上 Secure 的 cookie 会被浏览器直接丢掉，
# 表现是「登录成功，但刷新一下就退回登录页」。
# ADMIN_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# 站点账号（导航栏右上角的登录 / 注册）
#
# 账号数据在 apps/api/data/users.json（该目录被 .gitignore，不进仓库）。
# 第一个站长用 CLI 建（页面上注册出来的一律是普通用户）：
#   npm run user:create -- --username <用户名> --nickname <昵称> --email <邮箱> --role owner
#
# 下面三项**都可以不配**：
# ---------------------------------------------------------------------------

# 会话签名密钥（≥32 字符）。不配就自动生成一份存在 apps/api/data/.session-secret（0600）。
# 设了它、且换掉它，等于让所有访客立刻掉线。
# USER_SESSION_SECRET=

# 会话有效期（毫秒）。默认 7 天。
# USER_SESSION_TTL_MS=604800000

# HTTPS 部署时设成 1，给访客会话 cookie 加 `Secure`（本地 http 调试必须留空，原因同上）。
# USER_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# 管理后台「文件管理」能碰的目录（白名单，逗号分隔，相对仓库根）
#
# 格式：`名称=相对路径`，省略名称就用目录名。**只有这里列出的目录能被浏览/上传/删除**，
# 客户端传什么路径都出不去；绝对路径与 `..` 会被直接忽略。
# 不配就用代码里的默认三处（站点资源 / 截图 / 服务文档）。
# 删除不是真删：文件会移到仓库根的 .admin-trash/<时间戳>/ 下。
# ---------------------------------------------------------------------------
# ADMIN_FILE_ROOTS=站点资源=apps/web/public,截图=shots,服务文档=services
